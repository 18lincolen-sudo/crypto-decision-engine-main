# ============================================================
# Crypto Decision Engine — .env.example
# Copy to .env (local) or set the variables per destination below.
# ============================================================

# ===================== RENDER (server worker) =====================
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET_KEY=your_bybit_secret_key
BYBIT_TESTNET=true
BOT_ADMIN_TOKEN=your_long_random_admin_token
BOT_DRY_RUN=true
BOT_AUTOSTART=false
BOT_RISK_LEVEL=medium
BOT_SYMBOLS=100
BOT_MIN_CONFIDENCE=60
BOT_POSITION_PERCENT=10
BOT_MAX_OPEN_POSITIONS=7
BOT_MAX_FUTURES_POSITIONS=2
BOT_SCAN_CONCURRENCY=5
BOT_SCAN_INTERVAL_SECONDS=300
BOT_KLINE_INTERVAL=240
BOT_REENTRY_COOLDOWN_HOURS=24
BOT_RATE_LIMIT_MAX=120
BOT_RATE_LIMIT_WINDOW_MS=60000
BOT_REQUEST_TIMEOUT_MS=15000
CORS_ORIGIN=https://your-site.netlify.app,http://localhost:8080,http://localhost:5173
PORT=3001
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===================== FIREBASE (server warm cache / KV) =====================
# Used by server/kvStore.ts to persist bot state, sim snapshots, backtest results,
# and compressed candle history across worker restarts and Render deploys.
# This is server-side only (service-account auth, never exposed to browser).
# FIREBASE_PROJECT_ID = the "project_id" from your service-account JSON.
FIREBASE_PROJECT_ID=cryptom-f7a95
# FIREBASE_SERVICE_ACCOUNT_KEY = the ENTIRE service-account JSON, minified to ONE line
# (keep the \n escapes inside private_key; no real newlines allowed in env vars).
# NEVER commit the real key — keep it in .env (gitignored) or in the Render Dashboard.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"cryptom-f7a95","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-fbsvc@cryptom-f7a95.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# ===================== NETLIFY (frontend build-time) =====================
# These are consumed by Vite at build time and baked into the JS bundle.
# Set them in the Netlify Dashboard -> Site settings -> Build & deploy -> Environment.
VITE_TRADING_API_URL=https://crypto-decision-engine-main-hev8.onrender.com
VITE_ENABLE_ANALYTICS=true
